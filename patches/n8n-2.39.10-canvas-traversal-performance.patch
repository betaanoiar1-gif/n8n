+/**
+ * Small ordered set used by graph traversal.
+ *
+ * The traversal needs the historical "move to front" ordering, but using
+ * Array.indexOf() + splice() + unshift() makes every reconverging branch
+ * increasingly expensive. A linked list plus an index keeps those operations
+ * O(1) while preserving the exact ordering semantics of the previous code.
+ */
+class OrderedNodeSet {
+	private readonly nodes = new Map<string, { prev: string | null; next: string | null }>();
+
+	private head: string | null = null;
+
+	private tail: string | null = null;
+
+	moveToFront(node: string): void {
+		if (this.head === node) return;
+
+		const existing = this.nodes.get(node);
+		if (existing) {
+			if (existing.prev !== null) this.nodes.get(existing.prev)!.next = existing.next;
+			if (existing.next !== null) this.nodes.get(existing.next)!.prev = existing.prev;
+			if (this.tail === node) this.tail = existing.prev;
+		} else {
+			this.nodes.set(node, { prev: null, next: null });
+		}
+
+		const oldHead = this.head;
+		const entry = this.nodes.get(node)!;
+		entry.prev = null;
+		entry.next = oldHead;
+		if (oldHead !== null) this.nodes.get(oldHead)!.prev = node;
+		else this.tail = node;
+		this.head = node;
+	}
+
+	toArray(): string[] {
+		const result: string[] = [];
+		let current = this.head;
+		while (current !== null) {
+			result.push(current);
+			current = this.nodes.get(current)!.next;
+		}
+		return result;
+	}
+}
